          "states": [
            {
              "id": "off",
              "label": "Without",
              "params": {
                "on": false
              },
              "caption": "Without it, people on foot must judge traffic from both directions at once."
            },
            {
              "id": "on",
              "label": "With",
              "params": {
                "on": true
              },
              "caption": "With it, they cross one direction at a time. Refuges cut pedestrian crashes by about {claim:int.fhwa.refuge}."
